+package com.intf.paychannel.adapter.zj.service.unify;
+
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONObject;
+import com.intf.paychannel.adapter.zj.model.enums.ZjUnifySharingLocalErrorEnums;
+import com.intf.paychannel.adapter.zj.model.unify.ZjUnifySharingChangeSnapshot;
+import com.intf.paychannel.adapter.zj.model.unify.ZjUnifySharingProcessResult;
+import com.intf.paychannel.common.enums.ChannelEnum;
+import com.intf.paychannel.common.exception.BizException;
+import com.intf.paychannel.model.entity.ChannelAccessConfigEntity;
+import com.intf.paychannel.model.payment.SharingDetailsDTO;
+import com.intf.paychannel.model.payment.UnifiedPaymentRequestDTO;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.BeanUtils;
+import org.springframework.stereotype.Component;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * 中金聚合支付分账参数预处理器。
+ *
+ * <p>只处理中金 Tx2811 请求。判断规则与协议支付门禁相同，但不调用协议支付类。
+ * 处理器始终复制统一下单请求，只允许修改副本的 {@code sharingDetails}。
+ * 清空明细后的单扣结算标识使用 {@code sharing_main_mer}，与协议支付保持一致。</p>
+ */
+@Component
+@Slf4j
+public class ZjUnifySharingParameterProcessor {
+
+    /**
+     * 聚合支付主接收方按金额全额自分账降级为单扣的变更类型。
+     */
+    static final String CHANGE_TYPE_SELF_FULL_AMOUNT_TO_SINGLE_DEBIT =
+            "ZJ_UNIFY_SELF_FULL_AMOUNT_TO_SINGLE_DEBIT";
+
+    /**
+     * 参数变更原因。
+     */
+    private static final String CHANGE_REASON = "未开通分账的中金商户将聚合支付主接收方按金额全额自分账降级为单扣";
+
+    /**
+     * 校验分账门禁并返回处理后的请求副本。
+     *
+     * @param originalRequest 原始统一下单请求，只读
+     * @param accessConfig    本次已定位的渠道接入配置快照
+     * @return 中金聚合分账预处理结果
+     */
+    public ZjUnifySharingProcessResult process(UnifiedPaymentRequestDTO originalRequest,
+                                               ChannelAccessConfigEntity accessConfig) {
+        try {
+            UnifiedPaymentRequestDTO processedRequest = copyRequest(originalRequest);
+            if (isEmpty(originalRequest.getSharingDetails())) {
+                return ZjUnifySharingProcessResult.pass(processedRequest);
+            }
+            if (!isConfigPairPresent(accessConfig)) {
+                return validatePassThrough(processedRequest);
+            }
+
+            boolean sharingEnabled = parseRequiredSharingEnabled(accessConfig.getSharingConfig());
+            String sharingMainMer = StringUtils.trimToNull(accessConfig.getSharingMainMer());
+            if (sharingMainMer == null) {
+                throw new ZjUnifySharingConfigException("中金聚合分账主接收方配置为空");
+            }
+            if (sharingEnabled) {
+                return validatePassThrough(processedRequest);
+            }
+            if (!isEquivalentSingleDebit(originalRequest, sharingMainMer)) {
+                return ZjUnifySharingProcessResult.failure(ZjUnifySharingLocalErrorEnums.SHARING_NOT_ENABLED);
+            }
+
+            ZjUnifySharingChangeSnapshot snapshot = buildSnapshot(originalRequest, accessConfig, sharingMainMer);
+            processedRequest.setSharingDetails(new ArrayList<SharingDetailsDTO>());
+            return ZjUnifySharingProcessResult.changed(processedRequest, snapshot);
+        } catch (ZjUnifySharingConfigException e) {
+            log.warn("中金聚合分账配置校验失败, merchantNo={}, orderId={}, message={}",
+                    merchantNo(originalRequest), orderId(originalRequest), e.getMessage());
+            return ZjUnifySharingProcessResult.failure(ZjUnifySharingLocalErrorEnums.SHARING_CONFIG_ERROR);
+        } catch (Exception e) {
+            log.error("中金聚合分账参数预处理异常, merchantNo={}, orderId={}",
+                    merchantNo(originalRequest), orderId(originalRequest), e);
+            return ZjUnifySharingProcessResult.failure(ZjUnifySharingLocalErrorEnums.SHARING_PROCESS_ERROR);
+        }
+    }
+
+    /**
+     * 校验允许分账的明细能否按现有聚合规则组装。
+     *
+     * @param processedRequest 处理后的请求副本
+     * @return 原样通过结果或分账参数失败结果
+     */
+    private ZjUnifySharingProcessResult validatePassThrough(UnifiedPaymentRequestDTO processedRequest) {
+        try {
+            ZjUnifySettlementAssembler.build(processedRequest.getSharingDetails(), null);
+            return ZjUnifySharingProcessResult.pass(processedRequest);
+        } catch (BizException e) {
+            return ZjUnifySharingProcessResult.failure(ZjUnifySharingLocalErrorEnums.SHARING_PARAM_ERROR);
+        }
+    }
+
+    /**
+     * 判断分账配置对是否同时非空。
+     *
+     * @param accessConfig 渠道接入配置
+     * @return 是否构成完整配置对
+     */
+    private boolean isConfigPairPresent(ChannelAccessConfigEntity accessConfig) {
+        return accessConfig != null
+                && StringUtils.isNotBlank(accessConfig.getSharingConfig())
+                && StringUtils.isNotBlank(accessConfig.getSharingMainMer());
+    }
+
+    /**
+     * 从完整配置对中读取必填的布尔开关。
+     *
+     * @param sharingConfig 分账 JSON 配置
+     * @return 是否允许分账
+     */
+    private boolean parseRequiredSharingEnabled(String sharingConfig) {
+        final JSONObject config;
+        try {
+            config = JSON.parseObject(sharingConfig);
+        } catch (Exception e) {
+            throw new ZjUnifySharingConfigException("中金聚合分账配置不是合法 JSON 对象", e);
+        }
+        if (config == null || !config.containsKey("sharingEnabled")) {
+            throw new ZjUnifySharingConfigException("中金聚合分账配置缺少 sharingEnabled");
+        }
+        Object value = config.get("sharingEnabled");
+        if (!(value instanceof Boolean)) {
+            throw new ZjUnifySharingConfigException("中金聚合分账配置 sharingEnabled 必须为布尔类型");
+        }
+        return (Boolean) value;
+    }
+
+    /**
+     * 判断请求是否与主接收方单扣经济效果等价。
+     *
+     * @param request        原始支付请求
+     * @param sharingMainMer 中金主结算标识
+     * @return 是否满足等价单扣条件
+     */
+    private boolean isEquivalentSingleDebit(UnifiedPaymentRequestDTO request, String sharingMainMer) {
+        List<SharingDetailsDTO> details = request.getSharingDetails();
+        if (details == null || details.size() != 1) {
+            return false;
+        }
+        SharingDetailsDTO detail = details.get(0);
+        if (detail == null || !isAmountType(detail.getSharingType())) {
+            return false;
+        }
+        if (!StringUtils.equals(StringUtils.trimToEmpty(detail.getSharingMerId()), sharingMainMer)) {
+            return false;
+        }
+        return detail.getSharingAmt() != null
+                && request.getTransactionAmt() != null
+                && detail.getSharingAmt().compareTo(request.getTransactionAmt()) == 0;
+    }
+
+    /**
+     * 判断统一分账类型是否为按金额类型。
+     *
+     * <p>与协议支付门禁相同：空、{@code 1}、{@code 30} 视为按金额。
+     * 允许分账时，现有聚合组包仍只接受空、{@code 1}、{@code 2}。</p>
+     *
+     * @param sharingType 分账类型
+     * @return 是否为按金额类型
+     */
+    private boolean isAmountType(Integer sharingType) {
+        return sharingType == null || Integer.valueOf(1).equals(sharingType)
+                || Integer.valueOf(30).equals(sharingType);
+    }
+
+    /**
+     * 创建只包含门禁判定字段的审计快照。
+     *
+     * @param request        原始请求
+     * @param accessConfig   渠道接入配置
+     * @param sharingMainMer 中金主结算标识
+     * @return 参数变更快照
+     */
+    private ZjUnifySharingChangeSnapshot buildSnapshot(UnifiedPaymentRequestDTO request,
+                                                       ChannelAccessConfigEntity accessConfig,
+                                                       String sharingMainMer) {
+        SharingDetailsDTO detail = request.getSharingDetails().get(0);
+        Map<String, Object> configSnapshot = new LinkedHashMap<String, Object>();
+        configSnapshot.put("sharingEnabled", false);
+        configSnapshot.put("sharingMainMer", sharingMainMer);
+        configSnapshot.put("settlementFlag", sharingMainMer);
+
+        Map<String, Object> detailSnapshot = new LinkedHashMap<String, Object>();
+        detailSnapshot.put("sharingMerId", StringUtils.trimToEmpty(detail.getSharingMerId()));
+        detailSnapshot.put("sharingAmt", detail.getSharingAmt());
+        detailSnapshot.put("sharingType", detail.getSharingType());
+
+        Map<String, Object> beforeData = new LinkedHashMap<String, Object>();
+        beforeData.put("transactionAmt", request.getTransactionAmt());
+        beforeData.put("sharingDetails", Collections.singletonList(detailSnapshot));
+
+        Map<String, Object> afterData = new LinkedHashMap<String, Object>();
+        afterData.put("transactionAmt", request.getTransactionAmt());
+        afterData.put("sharingDetails", Collections.emptyList());
+        afterData.put("splitType", "10");
+        afterData.put("settlementFlag", sharingMainMer);
+
+        return new ZjUnifySharingChangeSnapshot(request.getOrderId(), ChannelEnum.ZJPAY, accessConfig.getProfile(),
+                request.getMerchantNo(), CHANGE_TYPE_SELF_FULL_AMOUNT_TO_SINGLE_DEBIT, configSnapshot,
+                beforeData, afterData, CHANGE_REASON, new Date());
+    }
+
+    /**
+     * 深复制统一下单请求中的分账明细。
+     *
+     * @param originalRequest 原始请求
+     * @return 请求副本
+     */
+    private UnifiedPaymentRequestDTO copyRequest(UnifiedPaymentRequestDTO originalRequest) {
+        if (originalRequest == null) {
+            throw new IllegalArgumentException("中金聚合支付请求不能为空");
+        }
+        UnifiedPaymentRequestDTO copy = new UnifiedPaymentRequestDTO();
+        BeanUtils.copyProperties(originalRequest, copy);
+        if (originalRequest.getSharingDetails() == null) {
+            copy.setSharingDetails(null);
+            return copy;
+        }
+        List<SharingDetailsDTO> copiedDetails = new ArrayList<SharingDetailsDTO>(
+                originalRequest.getSharingDetails().size());
+        for (SharingDetailsDTO detail : originalRequest.getSharingDetails()) {
+            copiedDetails.add(copyDetail(detail));
+        }
+        copy.setSharingDetails(copiedDetails);
+        return copy;
+    }
+
+    /**
+     * 深复制单条分账明细。
+     *
+     * @param detail 原始分账明细
+     * @return 分账明细副本
+     */
+    private SharingDetailsDTO copyDetail(SharingDetailsDTO detail) {
+        if (detail == null) {
+            return null;
+        }
+        SharingDetailsDTO copy = new SharingDetailsDTO();
+        copy.setSharingMerId(detail.getSharingMerId());
+        copy.setSharingAmt(detail.getSharingAmt());
+        copy.setSharingType(detail.getSharingType());
+        copy.setSharingNotifyUrl(detail.getSharingNotifyUrl());
+        copy.setSharingOrderId(detail.getSharingOrderId());
+        return copy;
+    }
+
+    /**
+     * 判断列表是否为空。
+     *
+     * @param details 分账明细
+     * @return 是否为空
+     */
+    private boolean isEmpty(List<SharingDetailsDTO> details) {
+        return details == null || details.isEmpty();
+    }
+
+    /**
+     * 安全读取请求商户号。
+     *
+     * @param request 支付请求
+     * @return 商户号
+     */
+    private String merchantNo(UnifiedPaymentRequestDTO request) {
+        return request == null ? null : request.getMerchantNo();
+    }
+
+    /**
+     * 安全读取请求订单号。
+     *
+     * @param request 支付请求
+     * @return 订单号
+     */
+    private String orderId(UnifiedPaymentRequestDTO request) {
+        return request == null ? null : request.getOrderId();
+    }
+
+    /**
+     * 中金聚合分账配置内容异常。
+     */
+    private static final class ZjUnifySharingConfigException extends RuntimeException {
+
+        /**
+         * 序列化版本号。
+         */
+        private static final long serialVersionUID = 1L;
+
+        /**
+         * 构造分账配置内容异常。
+         *
+         * @param message 异常信息
+         */
+        private ZjUnifySharingConfigException(String message) {
+            super(message);
+        }
+
+        /**
+         * 构造包含原始原因的分账配置内容异常。
+         *
+         * @param message 异常信息
+         * @param cause   原始异常
+         */
+        private ZjUnifySharingConfigException(String message, Throwable cause) {
+            super(message, cause);
+        }
+    }
+}
