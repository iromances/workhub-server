+package com.intf.paychannel.adapter.zj.model.unify;
+
+import com.intf.paychannel.adapter.zj.model.enums.ZjUnifySharingLocalErrorEnums;
+import com.intf.paychannel.model.payment.UnifiedPaymentRequestDTO;
+
+/**
+ * 中金聚合支付分账参数预处理结果。
+ */
+public final class ZjUnifySharingProcessResult {
+
+    /**
+     * 是否允许继续进入中金聚合支付服务。
+     */
+    private final boolean proceed;
+
+    /**
+     * 防御性复制并完成分账兼容处理后的统一下单请求。
+     */
+    private final UnifiedPaymentRequestDTO processedRequest;
+
+    /**
+     * 是否把主接收方全额自分账修改为单扣表达。
+     */
+    private final boolean changed;
+
+    /**
+     * 等价降级时的参数变更快照。
+     */
+    private final ZjUnifySharingChangeSnapshot changeSnapshot;
+
+    /**
+     * 不允许继续时的本地错误。
+     */
+    private final ZjUnifySharingLocalErrorEnums localError;
+
+    /**
+     * 构造中金聚合分账参数预处理结果。
+     *
+     * @param proceed          是否继续处理
+     * @param processedRequest 处理后的请求副本
+     * @param changed          是否发生参数变更
+     * @param changeSnapshot   参数变更快照
+     * @param localError       本地错误
+     */
+    private ZjUnifySharingProcessResult(boolean proceed, UnifiedPaymentRequestDTO processedRequest, boolean changed,
+                                        ZjUnifySharingChangeSnapshot changeSnapshot,
+                                        ZjUnifySharingLocalErrorEnums localError) {
+        this.proceed = proceed;
+        this.processedRequest = processedRequest;
+        this.changed = changed;
+        this.changeSnapshot = changeSnapshot;
+        this.localError = localError;
+    }
+
+    /**
+     * 创建未发生参数变更的成功结果。
+     *
+     * @param processedRequest 处理后的请求副本
+     * @return 成功结果
+     */
+    public static ZjUnifySharingProcessResult pass(UnifiedPaymentRequestDTO processedRequest) {
+        if (processedRequest == null) {
+            throw new IllegalArgumentException("处理后的中金聚合支付请求不能为空");
+        }
+        return new ZjUnifySharingProcessResult(true, processedRequest, false, null, null);
+    }
+
+    /**
+     * 创建发生等价单扣降级的成功结果。
+     *
+     * @param processedRequest 处理后的请求副本
+     * @param changeSnapshot   参数变更快照
+     * @return 变更成功结果
+     */
+    public static ZjUnifySharingProcessResult changed(UnifiedPaymentRequestDTO processedRequest,
+                                                      ZjUnifySharingChangeSnapshot changeSnapshot) {
+        if (processedRequest == null || changeSnapshot == null) {
+            throw new IllegalArgumentException("处理后的中金聚合支付请求和变更快照不能为空");
+        }
+        return new ZjUnifySharingProcessResult(true, processedRequest, true, changeSnapshot, null);
+    }
+
+    /**
+     * 创建门禁本地失败结果。
+     *
+     * @param localError 本地错误
+     * @return 失败结果
+     */
+    public static ZjUnifySharingProcessResult failure(ZjUnifySharingLocalErrorEnums localError) {
+        if (localError == null) {
+            throw new IllegalArgumentException("中金聚合分账门禁本地错误不能为空");
+        }
+        return new ZjUnifySharingProcessResult(false, null, false, null, localError);
+    }
+
+    /**
+     * 获取是否允许继续渠道调用。
+     *
+     * @return 是否允许继续
+     */
+    public boolean isProceed() {
+        return proceed;
+    }
+
+    /**
+     * 获取处理后的请求副本。
+     *
+     * @return 处理后的请求副本
+     */
+    public UnifiedPaymentRequestDTO getProcessedRequest() {
+        return processedRequest;
+    }
+
+    /**
+     * 获取是否发生参数变更。
+     *
+     * @return 是否发生参数变更
+     */
+    public boolean isChanged() {
+        return changed;
+    }
+
+    /**
+     * 获取参数变更快照。
+     *
+     * @return 参数变更快照
+     */
+    public ZjUnifySharingChangeSnapshot getChangeSnapshot() {
+        return changeSnapshot;
+    }
+
+    /**
+     * 获取本地错误。
+     *
+     * @return 本地错误
+     */
+    public ZjUnifySharingLocalErrorEnums getLocalError() {
+        return localError;
+    }
+}
