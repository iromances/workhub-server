+package com.intf.paychannel.adapter.zj.model.enums;
+
+import com.intf.paychannel.common.enums.PaymentStatusEnum;
+
+/**
+ * 中金聚合支付分账门禁本地错误与统一支付状态映射。
+ *
+ * <p>响应码字符串与协议支付门禁保持一致，枚举本身只供聚合支付使用。</p>
+ */
+public enum ZjUnifySharingLocalErrorEnums {
+
+    /**
+     * 完整配置对的内容不合法。
+     */
+    SHARING_CONFIG_ERROR("SHARING_CONFIG_ERROR", "中金分账配置异常", PaymentStatusEnum.FAILED),
+
+    /**
+     * 允许分账，但明细无法组装为中金聚合报文。
+     */
+    SHARING_PARAM_ERROR("SHARING_PARAM_ERROR", "中金分账参数校验失败", PaymentStatusEnum.FAILED),
+
+    /**
+     * 未开通分账且不满足等价单扣条件。
+     */
+    SHARING_NOT_ENABLED("SHARING_NOT_ENABLED", "当前中金商户未开通分账，且分账明细不满足等价单扣条件",
+            PaymentStatusEnum.FAILED),
+
+    /**
+     * 等价降级的审计日志保存失败。
+     */
+    SHARING_CHANGE_LOG_ERROR("SHARING_CHANGE_LOG_ERROR", "中金分账参数变更日志保存失败",
+            PaymentStatusEnum.FAILED),
+
+    /**
+     * 分账门禁内未预期的本地处理错误。
+     */
+    SHARING_PROCESS_ERROR("SHARING_PROCESS_ERROR", "中金分账参数处理失败", PaymentStatusEnum.FAILED);
+
+    /**
+     * 本地响应码。
+     */
+    private final String code;
+
+    /**
+     * 本地响应信息。
+     */
+    private final String desc;
+
+    /**
+     * 映射后的统一支付状态。
+     */
+    private final PaymentStatusEnum paymentStatus;
+
+    /**
+     * 构造中金聚合分账门禁本地错误映射。
+     *
+     * @param code          本地响应码
+     * @param desc          本地响应信息
+     * @param paymentStatus 统一支付状态
+     */
+    ZjUnifySharingLocalErrorEnums(String code, String desc, PaymentStatusEnum paymentStatus) {
+        this.code = code;
+        this.desc = desc;
+        this.paymentStatus = paymentStatus;
+    }
+
+    /**
+     * 获取本地响应码。
+     *
+     * @return 本地响应码
+     */
+    public String getCode() {
+        return code;
+    }
+
+    /**
+     * 获取本地响应信息。
+     *
+     * @return 本地响应信息
+     */
+    public String getDesc() {
+        return desc;
+    }
+
+    /**
+     * 获取统一支付状态。
+     *
+     * @return 统一支付状态
+     */
+    public PaymentStatusEnum getPaymentStatus() {
+        return paymentStatus;
+    }
+
+    /**
+     * 映射为统一支付状态。
+     *
+     * @return 统一支付状态
+     */
+    public PaymentStatusEnum toPaymentStatus() {
+        return paymentStatus;
+    }
+}
