+package com.intf.paychannel.adapter.zj.support;
+
+import com.alibaba.fastjson.JSON;
+import com.intf.paychannel.adapter.zj.model.unify.ZjUnifySharingChangeSnapshot;
+import com.intf.paychannel.model.entity.ChannelSharingChangeLogEntity;
+import com.intf.paychannel.service.ChannelSharingChangeLogService;
+import org.springframework.stereotype.Component;
+
+import javax.annotation.Resource;
+
+/**
+ * 中金聚合支付分账参数变更日志支撑。
+ *
+ * <p>把聚合门禁快照转换为通用日志实体并持久化，不参与门禁判断，
+ * 也不调用协议支付的变更日志支撑。</p>
+ */
+@Component
+public class ZjUnifySharingChangeLogSupport {
+
+    /**
+     * 渠道分账参数变更日志服务。
+     */
+    @Resource
+    private ChannelSharingChangeLogService channelSharingChangeLogService;
+
+    /**
+     * 保存中金聚合分账参数变更日志。
+     *
+     * @param snapshot 参数变更快照
+     */
+    public void save(ZjUnifySharingChangeSnapshot snapshot) {
+        if (snapshot == null) {
+            throw new IllegalArgumentException("中金聚合分账参数变更快照不能为空");
+        }
+        ChannelSharingChangeLogEntity entity = new ChannelSharingChangeLogEntity();
+        entity.setSerialNo(snapshot.getSerialNo());
+        entity.setChannel(snapshot.getChannel());
+        entity.setProfile(snapshot.getProfile());
+        entity.setMerchantNo(snapshot.getMerchantNo());
+        entity.setChangeType(snapshot.getChangeType());
+        entity.setConfigSnapshot(JSON.toJSONString(snapshot.getConfigSnapshot()));
+        entity.setBeforeData(JSON.toJSONString(snapshot.getBeforeData()));
+        entity.setAfterData(JSON.toJSONString(snapshot.getAfterData()));
+        entity.setChangeReason(snapshot.getChangeReason());
+        entity.setRequestTime(snapshot.getRequestTime());
+        if (!channelSharingChangeLogService.save(entity)) {
+            throw new IllegalStateException("中金聚合分账参数变更日志保存失败");
+        }
+    }
+}