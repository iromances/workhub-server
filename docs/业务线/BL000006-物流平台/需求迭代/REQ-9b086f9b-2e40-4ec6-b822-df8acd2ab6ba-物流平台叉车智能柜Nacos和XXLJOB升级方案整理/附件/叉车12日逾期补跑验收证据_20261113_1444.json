        "sql": "SELECT b.id,b.bill_no,b.product_type,b.overdue_day,COUNT(r.id) AS record_count,SUM(r.fee_amount) AS actual_fee,MAX(CASE WHEN (b.product_type=1 AND r.subject_no='***') OR (b.product_type=2 AND r.subject_no='***') THEN r.principal END) AS customer_fee_base,MIN(r.start_date) AS start_date,MAX(r.end_date) AS end_date FROM lease_saps.bill_fee_record r JOIN lease_saps.customer_bill b ON b.bill_no=r.bill_no AND b.is_delete=0 WHERE r.end_date='***' AND r.is_delete=0 GROUP BY b.id,b.bill_no,b.product_type,b.overdue_day ORDER BY b.id LIMIT 100"
