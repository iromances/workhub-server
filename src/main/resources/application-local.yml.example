spring:
  datasource:
    druid:
      url: jdbc:mysql://10.10.116.133:3306/workhub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
      username: root
      password: root

workhub:
  jwt:
    secret: please-change-this-secret-before-production
  wecom:
    robot:
      enabled: false
      webhook:
  reminder:
    enabled: false
    due-soon-hours: 24
    dedupe-minutes: 60
    cron: "0 */30 * * * *"
  ai:
    provider: heuristic
    openrouter:
      enabled: false
      api-key:
      base-url: https://openrouter.ai/api/v1
      model: openai/gpt-4o-mini
      referer: http://127.0.0.1:8080
      title: WorkHub Server
    minimax:
      enabled: false
      api-key:
      base-url: https://api.minimaxi.com/v1
      model: M2-her
    codex-cli:
      enabled: false
      command: codex
      model: gpt-5.3-codex
      timeout-seconds: 120
      disable-plugins: true
  storage:
    local-path: data/uploads
