</mxCell><mxCell id="note8" value="A 为应用承载设备分组，D 为存储设备分组；编号用于图表对应，不代表已确认的资产编号或独立物理机。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1080" width="1030" height="30" /></mxCell></root></mxGraphModel></diagram><diagram name="消费分期应用架构与设备承载关系" id="05_应用架构与设备承载"><mxGraphModel dx="1100" dy="1160" grid="1" page="1" pageWidth="1100" pageHeight="1160"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="users" value="外部客户／合作方终端及业务服务器" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="20" width="470" height="85" /></mxCell><mxCell id="ops" value="内部运营／财务／管理员工作站" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="595" y="20" width="470" height="85" /></mxCell><mxCell id="edge" value="N1 网络与安全接入设备  防火墙／WAF／负载均衡的实际部署及型号待核实" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFFAED;strokeColor=#A67C33;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="165" width="1030" height="75" /></mxCell><mxCell id="a1" value="A1 接入应用服务器组&lt;br&gt;amp-gateway 对外接口网关  |  amp-admin 管理页面  |  amp-op-gateway 运营网关" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="300" width="1030" height="100" /></mxCell><mxCell id="a2" value="A2 通用业务应用服务器组&lt;br&gt;amp-order 订单／客户&lt;br&gt;amp-risk 及风控接口&lt;br&gt;认证与通用接口服务" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="475" width="315" height="150" /></mxCell><mxCell id="a3" value="A3 资方应用服务器组&lt;br&gt;amp-capital&lt;br&gt;配置目标 172.17.0.121&lt;br&gt;配置目标 172.17.0.125" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="395" y="475" width="315" height="150" /></mxCell><mxCell id="a4" value="A4 支付账务应用服务器&lt;br&gt;amp-payment／amp-saps&lt;br&gt;配置目标 amp-ssh-prod&lt;br&gt;物理地址待补齐" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="755" y="475" width="310" height="150" /></mxCell><mxCell id="db" value="D1 生产数据库设备&lt;br&gt;资源标识 amp-db-prod&lt;br&gt;MySQL 业务分库&lt;br&gt;物理主机／实例待补齐" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="730" width="315" height="125" /></mxCell><mxCell id="oss" value="D2 文件存储设备&lt;br&gt;OSS 对象存储&lt;br&gt;合同、影像和业务附件&lt;br&gt;存储实例待核实" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="395" y="730" width="315" height="125" /></mxCell><mxCell id="log" value="D3 日志存储设备&lt;br&gt;应用日志文件&lt;br&gt;集中采集／存储待核实&lt;br&gt;D4 备份设备另行补齐" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFFAED;strokeColor=#A67C33;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="755" y="730" width="310" height="125" /></mxCell><mxCell id="middleware" value="M1 中间件承载设备  实例及部署地址待核实&lt;br&gt;Nacos 配置与注册  |  Redis 缓存和锁  |  AMQP 消息组件（代码存在依赖）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F2EDFC;strokeColor=#7851A9;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="940" width="1030" height="80" /></mxCell><mxCell id="ext" value="外部／共享服务  银行与支付渠道  |  电子签章  |  再保理资方系统（含嘉泰侧）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1060" width="1030" height="75" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="users" target="edge"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ops" target="edge"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="入口报文与页面请求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="edge" target="a1"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="a2"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="a3"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="a4"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="业务数据读写" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="db"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e7" value="通用文件服务" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="oss"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="375" y="580" /><mxPoint x="375" y="685" /><mxPoint x="550" y="685" /></Array></mxGeometry></mxCell><mxCell id="e8" value="运行日志" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="a4" target="log"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="a2" target="middleware"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="15" y="550" /><mxPoint x="15" y="980" /></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a4" target="ext"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1085" y="550" /><mxPoint x="1085" y="1097" /></Array></mxGeometry></mxCell><mxCell id="note0" value="D1 为共享展示的数据库设备：A2／A3／A4 各模块按职责读写对应业务库，不表示只由 A2 访问。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="870" width="1030" height="30" /></mxCell><mxCell id="note1" value="蓝色为应用模块；橙色为存储；虚线表示待核实的设备环节或部署关系。服务器组不等于独立物理服务器。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1135" width="1030" height="30" /></mxCell></root></mxGraphModel></diagram></mxfile>