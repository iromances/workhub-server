<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="客户与合作方的进件审核及放款流程" id="01_进件审核与放款流程"><mxGraphModel dx="1100" dy="1080" grid="1" page="1" pageWidth="1100" pageHeight="1080"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="u" value="客户终端／合作方终端&lt;br&gt;填写资料和分期申请" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="300" height="100" /></mxCell><mxCell id="p" value="合作方业务服务器&lt;br&gt;汇总申请与附件索引" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="20" width="330" height="100" /></mxCell><mxCell id="gw" value="A1 接入应用服务器&lt;br&gt;amp-gateway&lt;br&gt;接口校验与路由" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="190" width="330" height="110" /></mxCell><mxCell id="order" value="A2 订单应用服务器&lt;br&gt;amp-order&lt;br&gt;校验规则并保存申请" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="365" width="330" height="110" /></mxCell><mxCell id="db" value="D1 生产数据库设备&lt;br&gt;amp_order&lt;br&gt;申请单及客户银行卡" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="365" width="300" height="110" /></mxCell><mxCell id="audit" value="运营／审核人员终端&lt;br&gt;经后台和运营网关&lt;br&gt;提交项目所需审核" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="365" width="270" height="110" /></mxCell><mxCell id="risk" value="A2 风控应用服务器&lt;br&gt;amp-risk 及风控接口&lt;br&gt;获取审核结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="540" width="330" height="110" /></mxCell><mxCell id="stop" value="未通过或需补件&lt;br&gt;返回拒绝／补件结果&lt;br&gt;保存处理状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="540" width="300" height="110" /></mxCell><mxCell id="cap" value="A3 资方应用服务器&lt;br&gt;amp-capital&lt;br&gt;放款申请与计划管理" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="715" width="330" height="110" /></mxCell><mxCell id="pay" value="A4 支付应用服务器&lt;br&gt;amp-payment&lt;br&gt;按路由对接支付渠道" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="715" width="270" height="110" /></mxCell><mxCell id="ext" value="资方外部系统&lt;br&gt;再保理项目含嘉泰侧&lt;br&gt;审批和放款状态交互" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="715" width="300" height="110" /></mxCell><mxCell id="saps" value="A4 账务应用服务器&lt;br&gt;amp-saps&lt;br&gt;生成账单并同步结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="905" width="330" height="110" /></mxCell><mxCell id="db2" value="D1 生产数据库设备&lt;br&gt;amp_capital／amp_saps&lt;br&gt;放款单与还款计划" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="905" width="300" height="110" /></mxCell><mxCell id="e0" value="申请资料" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="p"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="申请报文" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p" target="gw"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="申请单／客户资料" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gw" target="order"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="读写" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order" target="db"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="audit" target="order"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="风控请求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order" target="risk"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="未通过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="risk" target="stop"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e7" value="通过并满足放款条件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="risk" target="cap"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cap" target="pay"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e9" value="按项目" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cap" target="ext"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e10" value="放款成功／还款计划" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cap" target="saps"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e11" value="账单" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="saps" target="db2"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e12" value="放款记录" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cap" target="db2"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="450" y="855" /><mxPoint x="180" y="855" /></Array></mxGeometry></mxCell><mxCell id="note0" value="箭头表示主要数据流；应答和状态同步可沿接口返回。项目审核及资金路由由项目配置决定。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1040" width="1030" height="30" /></mxCell></root></mxGraphModel></diagram><diagram name="客户和财务人员的还款核销及结算流程" id="02_还款核销与结算流程"><mxGraphModel dx="1100" dy="1030" grid="1" page="1" pageWidth="1100" pageHeight="1030"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="u" value="客户／合作方终端&lt;br&gt;还款申请及账单查询" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="310" height="100" /></mxCell><mxCell id="fin" value="财务人员终端&lt;br&gt;结算／对账／重新付款" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="20" width="310" height="100" /></mxCell><mxCell id="timer" value="应用调度程序&lt;br&gt;按项目配置发起任务" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F2EDFC;strokeColor=#7851A9;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="20" width="280" height="100" /></mxCell><mxCell id="saps" value="A4 账务应用服务器&lt;br&gt;amp-saps&lt;br&gt;账单校验与交易登记" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="220" width="310" height="120" /></mxCell><mxCell id="payment" value="A4 支付应用服务器&lt;br&gt;amp-payment&lt;br&gt;创建支付／代付订单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="420" width="310" height="115" /></mxCell><mxCell id="dbp" value="D1 生产数据库设备&lt;br&gt;amp_payment&lt;br&gt;业务订单和渠道流水" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="420" width="310" height="115" /></mxCell><mxCell id="channel" value="外部支付渠道服务器&lt;br&gt;银行／支付机构&lt;br&gt;受理并处理交易" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="420" width="280" height="115" /></mxCell><mxCell id="result" value="A4 支付应用服务器&lt;br&gt;接收回调或查询结果&lt;br&gt;更新渠道和业务状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="615" width="310" height="115" /></mxCell><mxCell id="exception" value="失败／处理中&lt;br&gt;保留状态并查询或处理&lt;br&gt;不得记为成功核销" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="615" width="280" height="115" /></mxCell><mxCell id="verify" value="A4 账务应用服务器&lt;br&gt;amp-saps&lt;br&gt;按成功结果核销账单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="810" width="310" height="115" /></mxCell><mxCell id="dbs" value="D1 生产数据库设备&lt;br&gt;amp_saps&lt;br&gt;账单／交易／对账单" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="810" width="310" height="115" /></mxCell><mxCell id="external" value="合作方／资方系统&lt;br&gt;接收账务及结算状态&lt;br&gt;相关项目含再保理侧" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="810" width="280" height="115" /></mxCell><mxCell id="e0" value="经接入网关" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="saps"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="185" y="165" /><mxPoint x="470" y="165" /></Array></mxGeometry></mxCell><mxCell id="e1" value="经后台与运营网关" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fin" target="saps"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="到期任务" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="timer" target="saps"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="930" y="170" /><mxPoint x="660" y="170" /></Array></mxGeometry></mxCell><mxCell id="e3" value="账单号／金额／支付要素" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="saps" target="payment"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="读写" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="payment" target="dbp"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="请求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="payment" target="channel"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="结果" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="channel" target="payment"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e7" value="处理中的交易持续查询" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="payment" target="result"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="result" target="exception"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e9" value="成功结果通知" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="result" target="verify"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e10" value="读写" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verify" target="dbs"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verify" target="external"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="note0" value="财务人员查询和导出结果，经后台与运营网关返回终端；交易结果可能通过异步通知到达。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="960" width="1030" height="30" /></mxCell><mxCell id="note1" value="资金划拨由银行／支付机构执行；图中箭头描述业务请求与结果数据的交换。" style="text;html=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="990" width="1030" height="30" /></mxCell></root></mxGraphModel></diagram><diagram name="运营人员和系统管理员的管理查询流程" id="03_管理查询与审计流程"><mxGraphModel dx="1100" dy="930" grid="1" page="1" pageWidth="1100" pageHeight="930"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="user" value="运营／财务／系统管理员工作站&lt;br&gt;登录并按角色查询或管理" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#F1F3F5;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="390" height="110" /></mxCell><mxCell id="web" value="A1 Web 承载服务器&lt;br&gt;amp-admin&lt;br&gt;向浏览器提供管理页面" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="30" width="390" height="110" /></mxCell><mxCell id="gw" value="A1 运营网关服务器&lt;br&gt;amp-op-gateway&lt;br&gt;转发管理接口请求" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="230" width="390" height="110" /></mxCell><mxCell id="auth" value="A2 认证权限应用服务器&lt;br&gt;amp-auth&lt;br&gt;认证及账号角色权限管理" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="435" width="390" height="115" /></mxCell><mxCell id="business" value="A2／A3／A4 业务服务器&lt;br&gt;订单／资方／支付／账务&lt;br&gt;处理角色权限范围内的操作" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#EAF3FC;strokeColor=#27609A;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="435" width="390" height="115" /></mxCell><mxCell id="dba" value="D1 生产数据库设备&lt;br&gt;amp_auth.sys_user／sys_role&lt;br&gt;账号和角色；sys_log 操作日志" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="650" width="390" height="120" /></mxCell><mxCell id="dbb" value="D1 生产数据库设备&lt;br&gt;业务库及 application_log&lt;br&gt;业务记录／处理结果／操作轨迹" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFF3E6;strokeColor=#BD7627;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="650" width="390" height="120" /></mxCell><mxCell id="logs" value="D3 运行日志承载设备  应用日志文件 → 日志采集／集中存储设备待核实" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fillColor=#FFFAED;strokeColor=#A67C33;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="825" width="990" height="70" /></mxCell><mxCell id="e0" value="页面请求" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="web"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="页面资源" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;